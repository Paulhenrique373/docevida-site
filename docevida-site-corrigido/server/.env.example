# Copie para .env (ou defina no ambiente de hospedagem). NUNCA versione valores reais.
NODE_ENV=development
PORT=4000
# Caminho do arquivo SQLite (use um disco persistente em produção)
DATABASE_PATH=./data/docevida.db
# OBRIGATÓRIO em produção: string aleatória com 32+ caracteres (gera as chaves de acompanhamento dos pedidos).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=
# Origens permitidas para CORS, separadas por vírgula. Vazio = apenas mesma origem.
CORS_ORIGINS=http://localhost:3000
# Taxa de entrega em centavos (ex.: 800 = R$ 8,00). Vazio = "a combinar" (o total fica pendente até a loja definir).
DELIVERY_FEE_CENTS=
# Duração da sessão administrativa em horas
SESSION_TTL_HOURS=12
# Defina como 1 quando estiver atrás de proxy reverso (Render, Nginx, etc.) para IP/HTTPS corretos
TRUST_PROXY=0
